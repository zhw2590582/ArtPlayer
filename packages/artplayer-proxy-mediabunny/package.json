{
  "name": "artplayer-proxy-mediabunny",
  "version": "1.2.0",
  "description": "mediabunny proxy for ArtPlayer",
  "author": "Harvey Zhao <laozhaochaguan@gmail.com>",
  "license": "MIT",
  "homepage": "https://artplayer.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhw2590582/ArtPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/zhw2590582/ArtPlayer/issues"
  },
  "keywords": [
    "html5",
    "video",
    "player"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/artplayer-proxy-mediabunny.d.mts",
        "default": "./dist/artplayer-proxy-mediabunny.mjs"
      },
      "require": {
        "types": "./types/artplayer-proxy-mediabunny.d.ts",
        "default": "./dist/artplayer-proxy-mediabunny.js"
      }
    },
    "./legacy": {
      "import": {
        "types": "./types/artplayer-proxy-mediabunny.d.mts",
        "default": "./dist/artplayer-proxy-mediabunny.legacy.js"
      },
      "require": {
        "types": "./types/artplayer-proxy-mediabunny.d.ts",
        "default": "./dist/artplayer-proxy-mediabunny.legacy.js"
      }
    }
  },
  "main": "./dist/artplayer-proxy-mediabunny.js",
  "module": "./dist/artplayer-proxy-mediabunny.mjs",
  "types": "./types/artplayer-proxy-mediabunny.d.ts",
  "legacy": "./dist/artplayer-proxy-mediabunny.legacy.js",
  "browserslist": "last 1 Chrome version",
  "typesVersions": {
    "*": {
      "legacy": ["types/artplayer-proxy-mediabunny.d.ts"]
    }
  },
  "dependencies": {
    "mediabunny": "^1.43.1"
  }
}
