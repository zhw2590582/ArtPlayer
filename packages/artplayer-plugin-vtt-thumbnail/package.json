{
  "name": "artplayer-plugin-vtt-thumbnail",
  "version": "1.1.0",
  "description": "vtt thumbnail plugin for ArtPlayer",
  "author": "Harvey Zhao <laozhaochaguan@gmail.com>",
  "license": "MIT",
  "homepage": "https://artplayer.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhw2590582/ArtPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/zhw2590582/ArtPlayer/issues"
  },
  "keywords": [
    "html5",
    "video",
    "player"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/artplayer-plugin-vtt-thumbnail.d.mts",
        "default": "./dist/artplayer-plugin-vtt-thumbnail.mjs"
      },
      "require": {
        "types": "./types/artplayer-plugin-vtt-thumbnail.d.cts",
        "default": "./dist/artplayer-plugin-vtt-thumbnail.js"
      }
    },
    "./legacy": {
      "import": {
        "types": "./types/artplayer-plugin-vtt-thumbnail.d.mts",
        "default": "./dist/artplayer-plugin-vtt-thumbnail.legacy.js"
      },
      "require": {
        "types": "./types/artplayer-plugin-vtt-thumbnail.d.cts",
        "default": "./dist/artplayer-plugin-vtt-thumbnail.legacy.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./types/runtime.d.mts",
        "default": "./dist/artplayer-plugin-vtt-thumbnail.mjs"
      },
      "require": {
        "types": "./types/runtime.d.cts",
        "default": "./dist/artplayer-plugin-vtt-thumbnail.js"
      }
    }
  },
  "main": "./dist/artplayer-plugin-vtt-thumbnail.js",
  "module": "./dist/artplayer-plugin-vtt-thumbnail.mjs",
  "types": "./types/artplayer-plugin-vtt-thumbnail.d.ts",
  "legacy": "./dist/artplayer-plugin-vtt-thumbnail.legacy.js",
  "browserslist": "last 1 Chrome version",
  "typesVersions": {
    "*": {
      "legacy": [
        "types/artplayer-plugin-vtt-thumbnail.d.ts"
      ],
      "runtime": [
        "types/runtime.d.ts"
      ]
    }
  }
}
