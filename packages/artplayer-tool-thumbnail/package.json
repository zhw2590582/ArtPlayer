{
  "name": "artplayer-tool-thumbnail",
  "version": "4.4.0",
  "description": "Thumbnail tool for ArtPlayer",
  "author": "Harvey Zhao <laozhaochaguan@gmail.com>",
  "license": "MIT",
  "legacy": "dist/artplayer-tool-thumbnail.legacy.js",
  "homepage": "https://artplayer.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhw2590582/ArtPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/zhw2590582/ArtPlayer/issues"
  },
  "keywords": [
    "html5",
    "video",
    "player"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/artplayer-tool-thumbnail.d.mts",
        "default": "./dist/artplayer-tool-thumbnail.mjs"
      },
      "require": {
        "types": "./types/artplayer-tool-thumbnail.d.cts",
        "default": "./dist/artplayer-tool-thumbnail.js"
      },
      "default": "./dist/artplayer-tool-thumbnail.js"
    },
    "./legacy": {
      "types": "./types/artplayer-tool-thumbnail.d.cts",
      "import": "./dist/artplayer-tool-thumbnail.legacy.js",
      "require": "./dist/artplayer-tool-thumbnail.legacy.js",
      "default": "./dist/artplayer-tool-thumbnail.legacy.js"
    }
  },
  "main": "./dist/artplayer-tool-thumbnail.js",
  "module": "./dist/artplayer-tool-thumbnail.mjs",
  "types": "./types/artplayer-tool-thumbnail.d.ts",
  "browserslist": "last 1 Chrome version",
  "typesVersions": {
    "*": {
      "legacy": [
        "types/artplayer-tool-thumbnail.d.ts"
      ]
    }
  },
  "files": [
    "ARCHITECTURE.md",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "dist",
    "types"
  ]
}
