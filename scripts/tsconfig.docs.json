{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "checkJs": true
  },
  "include": [
    "consumers/**/*.ts",
    "docs-smoke/**/*.ts",
    "build-test.js",
    "build-ts.js",
    "build-site-assets.mjs",
    "build-llm.js",
    "trans-docs.js",
    "documentation/**/*.ts",
    "editor-declarations/**/*.ts",
    "editor-types.mjs",
    "plugin-editor-types.mjs",
    "site-build/**/*.ts",
    "site-vendor/**/*.ts",
    "build-site-notices.mjs",
    "build-i18n.js",
    "build-docs.js",
    "check-site-links.mjs",
    "../packages/artplayer-vitepress/build/**/*.ts",
    "build-vconsole.mjs",
    "browser-validation/**/*.ts",
    "../test/browser/chapter-hover.ts",
    "build-console.mjs"
  ]
}
